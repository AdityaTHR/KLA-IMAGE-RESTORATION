{
  "run_id": "B1_LIGHTWEIGHT_CNN",
  "model": {
    "name": "lightweight_sr",
    "in_channels": 1,
    "out_channels": 1,
    "num_features": 32,
    "num_blocks": 4
  },
  "data": {
    "noisy_dir": "data/extracted/train/NoisyLR",
    "gt_dir": "data/extracted/train/GT",
    "test_dir": "data/extracted/test/NoisyLR",
    "splits_dir": "data/splits",
    "train_split": "data/splits/train.txt",
    "val_split": "data/splits/val.txt",
    "dev_test_split": "data/splits/dev_test.txt"
  },
  "training": {
    "seed": 42,
    "epochs": 3,
    "batch_size": 16,
    "num_workers": 0,
    "augment": true,
    "optimizer": {
      "name": "adam",
      "lr": 0.001,
      "weight_decay": 0.0,
      "betas": [
        0.9,
        0.999
      ]
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 3,
      "eta_min": 0.0001
    },
    "loss": {
      "name": "charbonnier",
      "epsilon": 0.001
    },
    "amp": false,
    "gradient_clip": 1.0
  },
  "checkpoint": {
    "dir": "checkpoints",
    "save_every": 1,
    "filename": "baseline_cnn_repro",
    "best_filename": "baseline_cnn_best.pth"
  },
  "evaluation": {
    "output_dir": "outputs/baseline_cnn",
    "save_images": true,
    "max_save": 20,
    "metrics": [
      "psnr",
      "ssim",
      "lpips"
    ]
  },
  "logging": {
    "experiment_log": "docs/experiment_log.csv"
  }
}